<% content_for "header" do %>
<title><%= I18n.translate(locale, "Playlists") %> - Invidious</title>
<% end %>

<div class="page-head">
    <h1 class="page-head__title"><%= I18n.translate(locale, "user_created_playlists", %(<span id="count">#{items_created.size}</span>)) %></h1>
    <a class="btn btn--sm btn--accent" href="/create_playlist?referer=<%= URI.encode_www_form("/feed/playlists") %>">
        <svg class="icon icon--sm"><use href="#i-add"/></svg>
        <%= I18n.translate(locale, "Create playlist") %>
    </a>
    <a class="btn btn--sm" href="/data_control?referer=<%= URI.encode_www_form("/feed/playlists") %>">
        <svg class="icon icon--sm"><use href="#i-data"/></svg>
        <%= I18n.translate(locale, "Import/export") %>
    </a>
</div>

<div class="grid">
<% items_created.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<div class="sect__head">
    <h2 class="sect__title"><%= I18n.translate(locale, "user_saved_playlists", %(<span id="count">#{items_saved.size}</span>)) %></h2>
</div>

<div class="grid">
<% items_saved.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<script src="/js/watched_indicator.js?v=<%= ASSET_COMMIT %>"></script>
