<% content_for "header" do %>
<meta name="description" content="<%= I18n.translate(locale, "An alternative front-end to YouTube") %>">
<title>
    <% if env.get("preferences").as(Preferences).default_home != "Trending" %>
        <%= I18n.translate(locale, "Trending") %> - Invidious
    <% else %>
        Invidious
    <% end %>
</title>
<% end %>

<div class="page-head">
    <h1 class="page-head__title"><%= I18n.translate(locale, "Trending") %></h1>
    <% if plid %>
        <a class="btn btn--sm" href="/playlist?list=<%= plid %>">
            <svg class="icon icon--sm"><use href="#i-list"/></svg>
            <%= I18n.translate(locale, "View as playlist") %>
        </a>
    <% end %>
</div>

<div class="pillbar">
    <a class="pill" href="/feed/trending?region=<%= region %>"<% if trending_type != "Livestreams" && trending_type != "Gaming" %> aria-current="page"<% end %>>
        <%= I18n.translate(locale, "Trending") %>
    </a>
    <% {"Livestreams", "Gaming"}.each do |option| %>
        <a class="pill" href="/feed/trending?type=<%= option %>&region=<%= region %>"<% if trending_type == option %> aria-current="page"<% end %>>
            <%= I18n.translate(locale, option) %>
        </a>
    <% end %>
</div>

<div class="grid">
<% trending.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<script src="/js/watched_indicator.js?v=<%= ASSET_COMMIT %>"></script>
