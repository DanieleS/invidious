<% content_for "header" do %>
<title><%= I18n.translate(locale, "History") %> - Invidious</title>
<% end %>

<div class="page-head">
    <h1 class="page-head__title"><%= I18n.translate(locale, "History") %></h1>
    <span class="page-head__note"><%= I18n.translate_count(locale, "generic_videos_count", user.watched.size, I18n::NumberFormatting::HtmlSpan) %></span>
    <a class="btn btn--sm" href="/feed/subscriptions">
        <%= I18n.translate_count(locale, "generic_subscriptions_count", user.subscriptions.size, I18n::NumberFormatting::HtmlSpan) %>
    </a>
    <a class="btn btn--sm btn--danger" href="/clear_watch_history">
        <svg class="icon icon--sm"><use href="#i-trash"/></svg>
        <%= I18n.translate(locale, "Clear watch history") %>
    </a>
</div>

<script id="watched_data" type="application/json">
<%=
{
    "csrf_token" => URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "")
}.to_pretty_json
%>
</script>
<script src="/js/watched_widget.js?v=<%= ASSET_COMMIT %>"></script>

<div class="grid">
    <% watched.each do |item| %>
        <div class="card">
            <div style="position:relative">
                <a class="thumb" href="/watch?v=<%= item %>">
                    <img loading="lazy" src="/vi/<%= item %>/mqdefault.jpg" alt="" />
                </a>
                <div class="thumb-actions">
                    <form data-onsubmit="return_false" action="/watch_ajax?action=mark_unwatched&id=<%= item %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "") %>">
                        <button type="submit" title="<%= I18n.translate(locale, "Clear watch history") %>"
                                data-onclick="mark_unwatched" data-id="<%= item %>">
                            <svg class="icon icon--sm"><use href="#i-trash"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    <% end %>
</div>

<%=
  IV::Frontend::Pagination.nav_numeric(locale,
    base_url: base_url,
    current_page: page,
    show_next: (watched.size >= max_results)
  )
%>
