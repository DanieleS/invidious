<% content_for "header" do %>
<meta name="description" content="<%= I18n.translate(locale, "An alternative front-end to YouTube") %>">
<title>
    Invidious
</title>
<% end %>

<div class="notice">
    <svg class="icon notice__icon"><use href="#i-alert"/></svg>
    <div class="notice__body"><%= message %></div>
</div>
