<% title = HTML.escape(playlist.title) %>

<% content_for "header" do %>
<title><%= title %> - Invidious</title>
<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/playlist/<%= plid %>" />
<% end %>

<form action="/edit_playlist?list=<%= plid %>" method="post">
    <div class="playlist-head">
        <div class="page-head">
            <input class="page-head__title" maxlength="150" name="title" type="text" value="<%= title %>"
                aria-label="<%= I18n.translate(locale, "Title") %>" style="font-family:var(--font-display);font-weight:700">

            <a class="btn btn--sm" dir="auto" href="/playlist?list=<%= plid %>">
                <svg class="icon icon--sm"><use href="#i-close"/></svg> <%= I18n.translate(locale, "generic_button_cancel") %>
            </a>
            <button class="btn btn--sm btn--accent" dir="auto" type="submit">
                <svg class="icon icon--sm"><use href="#i-tick"/></svg> <%= I18n.translate(locale, "generic_button_save") %>
            </button>
            <a class="btn btn--sm btn--danger" dir="auto" href="/delete_playlist?list=<%= plid %>">
                <svg class="icon icon--sm"><use href="#i-trash"/></svg> <%= I18n.translate(locale, "generic_button_delete") %>
            </a>
        </div>

        <div class="field">
            <span class="playlist-head__meta">
                <%= HTML.escape(playlist.author) %> · <%= I18n.translate_count(locale, "generic_videos_count", playlist.video_count) %>
            </span>
            <select name="privacy" aria-label="<%= I18n.translate(locale, "Playlist privacy") %>">
            <%- {"Public", "Unlisted", "Private"}.each do |option| -%>
                <option value="<%= option %>" <% if option == playlist.privacy.to_s %>selected<% end %>><%= I18n.translate(locale, option) %></option>
            <%- end -%>
            </select>
        </div>

        <textarea maxlength="5000" name="description" style="height:20vh"
            aria-label="<%= I18n.translate(locale, "Description") %>"><%= playlist.description %></textarea>
    </div>

    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
</form>

<%= rendered "components/items_paginated" %>
