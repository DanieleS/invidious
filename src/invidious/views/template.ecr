<%
  preferences = env.get("preferences").as(Preferences)
  locale = preferences.locale
  dark_mode = preferences.dark_mode
  current_page = env.get?("current_page").try &.as(String) || ""

  # `current_page` è già codificato per finire dentro un `?referer=`, quindi
  # "/feed/popular" ci arriva come "%2Ffeed%2Fpopular" e non si può
  # confrontare con il link di una voce di menu. Per sapere in che pagina
  # siamo serve il percorso vero, non la sua versione da querystring.
  current_path = env.request.path

  # Il menu delle sezioni vive nella testata. Chi non ha effettuato l'accesso
  # non ha iscrizioni né playlist, quindi quelle voci spariscono.
  feed_menu = preferences.feed_menu.dup
  if !env.get?("user")
    feed_menu.reject! { |item| {"Subscriptions", "Playlists"}.includes? item }
  end
%>
<!DOCTYPE html>
<html lang="<%= locale %>"<% if I18n.locale_is_rtl?(locale) %> dir="rtl"<% end %><% if dark_mode == "dark" || dark_mode == "light" %> data-theme="<%= dark_mode %>"<% end %>>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= yield_content "header" %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%= ASSET_COMMIT %>">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=<%= ASSET_COMMIT %>">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=<%= ASSET_COMMIT %>">
    <link rel="manifest" href="/site.webmanifest?v=<%= ASSET_COMMIT %>">
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=<%= ASSET_COMMIT %>" color="#dc2a3a">
    <meta name="msapplication-TileColor" content="#0a0d13">
    <meta name="theme-color" content="#0a0d13">

    <%
      # Safari su iOS ignora buona parte del manifest: senza questi tre meta
      # l'icona sulla schermata home apre una scheda del browser invece
      # dell'app a tutto schermo.
    %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content="Invidious">
    <link title="Invidious" type="application/opensearchdescription+xml" rel="search" href="/opensearch.xml">

    <%
      # I due font variabili coprono tutti i pesi che usiamo. Precaricati
      # perché il testo li aspetta: senza, la pagina disegna due volte.
    %>
    <link rel="preload" href="/fonts/figtree-latin.woff2?v=<%= ASSET_COMMIT %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/archivo-latin.woff2?v=<%= ASSET_COMMIT %>" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="/css/tokens.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/base.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/layout.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/components.css?v=<%= ASSET_COMMIT %>">

    <%
      # Lo script del tema va valutato prima che venga disegnato qualsiasi cosa,
      # altrimenti si vede il lampo di tema sbagliato: quindi qui, in <head>, e
      # senza defer. Le ragioni di cosa fa stanno nel file.
    %>
    <script src="/js/theme_boot.js?v=<%= ASSET_COMMIT %>"></script>

    <script src="/js/_helpers.js?v=<%= ASSET_COMMIT %>"></script>
</head>

<body>
    <%= rendered "components/icons" %>

    <a class="skip-to-content" href="#main"><%= I18n.translate(locale, "Skip to content") %></a>

    <div class="frame">
        <header class="masthead">
            <div class="shell masthead__in">
                <a class="wordmark" href="/">
                    <svg class="wordmark__lens" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="1.5" y="1.5" width="21" height="21" rx="6.5" fill="var(--accent)"/>
                        <path d="M9.4 7.6v8.8l7-4.4z" fill="var(--accent-on)"/>
                    </svg>
                    Invidious
                </a>

                <%
                  # La voce "Offline" sta in coda al menu e non dipende dalle
                  # preferenze: i video salvati sono l'unica cosa che si può
                  # ancora aprire quando la rete non c'è, e devono essere
                  # raggiungibili da qualsiasi pagina.
                %>
                <nav class="nav" aria-label="<%= I18n.translate(locale, "preferences_feed_menu_label") %>">
                    <% if !feed_menu.empty? %>
                        <% feed_menu.each do |feed| %>
                            <%
                              feed_path = "/feed/#{feed.downcase}"
                              feed_icon = case feed
                                          when "Popular"       then "i-fire"
                                          when "Trending"      then "i-trend"
                                          when "Subscriptions" then "i-star"
                                          when "Playlists"     then "i-list"
                                          when "History"       then "i-clock"
                                          else                      "i-search"
                                          end
                            %>
                            <a class="nav__item" href="<%= feed_path %>"<% if current_path.starts_with?(feed_path) %> aria-current="page"<% end %>>
                                <svg class="icon icon--sm"><use href="#<%= feed_icon %>"/></svg>
                                <%= I18n.translate(locale, feed) %>
                            </a>
                        <% end %>
                    <% end %>

                    <a class="nav__item" href="/offline"<% if current_path.starts_with?("/offline") %> aria-current="page"<% end %>>
                        <svg class="icon icon--sm"><use href="#i-offline"/></svg>
                        <%= I18n.translate(locale, "offline_page_title") %>
                    </a>
                </nav>

                <% if navbar_search %>
                    <% autofocus = false %><%= rendered "components/search_box" %>
                <% end %>

                <div class="masthead__tools">
                    <%
                      # Nasce nascosto: lo mostra pwa.js solo se il browser ci
                      # offre davvero il prompt di installazione. Un pulsante
                      # "Installa" che non installa niente è una bugia.
                    %>
                    <button type="button" id="install_app" class="iconbtn" title="<%= I18n.translate(locale, "pwa_install") %>" hidden>
                        <svg class="icon"><use href="#i-save"/></svg>
                        <span class="sr-only"><%= I18n.translate(locale, "pwa_install") %></span>
                    </button>

                    <a id="toggle_theme" class="iconbtn" href="/toggle_theme?referer=<%= env.get?("current_page") %>" title="<%= I18n.translate(locale, "toggle_theme") %>">
                        <svg class="icon" id="toggle_theme_icon"><use href="#i-sun"/></svg>
                        <span class="sr-only"><%= I18n.translate(locale, "toggle_theme") %></span>
                    </a>

                    <% if env.get? "user" %>
                        <a id="notification_ticker" class="iconbtn" title="<%= I18n.translate(locale, "Subscriptions") %>" href="/feed/subscriptions">
                            <% notification_count = env.get("user").as(Invidious::User).notifications.size %>
                            <% if CONFIG.enable_user_notifications && notification_count > 0 %>
                                <svg class="icon"><use href="#i-bell"/></svg>
                                <span class="iconbtn__badge" id="notification_count"><%= notification_count %></span>
                            <% else %>
                                <svg class="icon"><use href="#i-bell-off"/></svg>
                            <% end %>
                        </a>
                    <% end %>

                    <a class="iconbtn" title="<%= I18n.translate(locale, "Preferences") %>" href="/preferences?referer=<%= env.get?("current_page") %>">
                        <svg class="icon"><use href="#i-cog"/></svg>
                        <span class="sr-only"><%= I18n.translate(locale, "Preferences") %></span>
                    </a>

                    <% if env.get? "user" %>
                        <% if preferences.show_nick %>
                            <span class="masthead__user" id="user_name"><%= HTML.escape(env.get("user").as(Invidious::User).email) %></span>
                        <% end %>
                        <form action="/signout?referer=<%= env.get?("current_page") %>" method="post">
                            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                            <button type="submit" class="iconbtn" title="<%= I18n.translate(locale, "Log out") %>">
                                <svg class="icon"><use href="#i-exit"/></svg>
                                <span class="sr-only"><%= I18n.translate(locale, "Log out") %></span>
                            </button>
                        </form>
                    <% elsif CONFIG.login_enabled %>
                        <a class="btn btn--sm" href="/login?referer=<%= env.get?("current_page") %>">
                            <%= I18n.translate(locale, "Log in") %>
                        </a>
                    <% end %>
                </div>
            </div>
        </header>

        <% if CONFIG.banner %>
            <div class="banner"><div class="shell"><%= CONFIG.banner %></div></div>
        <% end %>

        <main id="main" class="shell page">
            <%= content %>
        </main>

        <footer class="footer">
            <div class="shell footer__in">
                <div class="footer__col">
                    <span class="footer__line">
                        <svg class="icon icon--sm"><use href="#i-github"/></svg>
                        <% if CONFIG.modified_source_code_url %>
                            <a href="https://github.com/iv-org/invidious"><%= I18n.translate(locale, "footer_original_source_code") %></a>
                            <span>/</span>
                            <a href="<%= CONFIG.modified_source_code_url %>"><%= I18n.translate(locale, "footer_modfied_source_code") %></a>
                        <% else %>
                            <a href="https://github.com/iv-org/invidious"><%= I18n.translate(locale, "footer_source_code") %></a>
                        <% end %>
                    </span>
                    <span class="footer__line">
                        <svg class="icon icon--sm"><use href="#i-doc"/></svg>
                        <a href="https://github.com/iv-org/documentation"><%= I18n.translate(locale, "footer_documentation") %></a>
                    </span>
                </div>

                <div class="footer__col">
                    <span class="footer__line">
                        <a href="https://github.com/iv-org/invidious/blob/master/LICENSE"><%= I18n.translate(locale, "Released under the AGPLv3 on Github.") %></a>
                    </span>
                    <span class="footer__line">
                        <svg class="icon icon--sm"><use href="#i-js"/></svg>
                        <a rel="jslicense" href="/licenses"><%= I18n.translate(locale, "View JavaScript license information.") %></a>
                    </span>
                    <span class="footer__line">
                        <svg class="icon icon--sm"><use href="#i-doc"/></svg>
                        <a href="/privacy"><%= I18n.translate(locale, "View privacy policy.") %></a>
                    </span>
                </div>

                <div class="footer__col">
                    <span class="footer__line">
                        <svg class="icon icon--sm"><use href="#i-wallet"/></svg>
                        <a href="https://invidious.io/donate/"><%= I18n.translate(locale, "footer_donate_page") %></a>
                    </span>
                    <span class="footer__line num">
                        <%= I18n.translate(locale, "Current version: ") %>
                        <% if CONFIG.modified_source_code_url %>
                            <a href="<%= CONFIG.modified_source_code_url %>/commit/<%= CURRENT_COMMIT %>"><%= CURRENT_VERSION %>-<%= CURRENT_COMMIT %></a>
                        <% else %>
                            <a href="https://github.com/iv-org/invidious/commit/<%= CURRENT_COMMIT %>"><%= CURRENT_VERSION %>-<%= CURRENT_COMMIT %></a>
                        <% end %>
                        @ <%= CURRENT_BRANCH %>
                        <% if CURRENT_TAG != "" %>
                            (<% if CONFIG.modified_source_code_url %><a href="<%= CONFIG.modified_source_code_url %>/releases/tag/<%= CURRENT_TAG %>"><%= CURRENT_TAG %></a><% else %><a href="https://github.com/iv-org/invidious/releases/tag/<%= CURRENT_TAG %>"><%= CURRENT_TAG %></a><% end %>)
                        <% end %>
                    </span>
                </div>
            </div>
        </footer>
    </div>

    <script src="/js/handlers.js?v=<%= ASSET_COMMIT %>"></script>
    <script src="/js/themes.js?v=<%= ASSET_COMMIT %>"></script>

    <script id="pwa_data" type="application/json"><%= {"version" => ASSET_COMMIT}.to_json %></script>
    <script src="/js/pwa.js?v=<%= ASSET_COMMIT %>"></script>
    <% if env.get? "user" %>
        <script src="/js/sse.js?v=<%= ASSET_COMMIT %>"></script>
        <script id="notification_data" type="application/json">
        <%=
        {
            "upload_text" => HTML.escape(I18n.translate(locale, "`x` uploaded a video")),
            "live_upload_text" => HTML.escape(I18n.translate(locale, "`x` is live"))
        }.to_pretty_json
        %>
        </script>
        <% if CONFIG.enable_user_notifications %>
        <script src="/js/notifications.js?v=<%= ASSET_COMMIT %>"></script>
        <% end %>
    <% end %>
</body>

</html>
