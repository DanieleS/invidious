<% content_for "header" do %>
<title><%= I18n.translate(locale, "Create playlist") %> - Invidious</title>
<% end %>

<form class="form narrow" action="/create_playlist?referer=<%= URI.encode_www_form(referer) %>" method="post">
    <div class="form__group">
        <legend class="form__legend"><%= I18n.translate(locale, "Create playlist") %></legend>

        <div class="field field--stack">
            <label for="title"><%= I18n.translate(locale, "Title") %></label>
            <input required id="title" name="title" type="text" placeholder="<%= I18n.translate(locale, "Title") %>">
        </div>

        <div class="field field--stack">
            <label for="privacy"><%= I18n.translate(locale, "Playlist privacy") %></label>
            <select name="privacy" id="privacy">
                <% PlaylistPrivacy.names.each do |option| %>
                    <option value="<%= option %>" <% if option == "Public" %> selected <% end %>><%= I18n.translate(locale, option) %></option>
                <% end %>
            </select>
        </div>

        <div class="form__actions">
            <button type="submit" name="action" value="create_playlist" class="btn btn--accent">
                <%= I18n.translate(locale, "Create playlist") %>
            </button>
        </div>

        <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
    </div>
</form>
