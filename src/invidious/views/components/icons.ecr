<%
  # Sprite di icone, inserito una volta sola in fondo alla testata.
  # Sta qui e non in un file .svg separato perché `<use href="esterno.svg#id">`
  # non è supportato in modo affidabile da tutti i browser: inline funziona
  # ovunque, viaggia già compresso con l'HTML e non costa una richiesta in più.
  # Uso: <svg class="icon"><use href="#i-nome"/></svg>
  # Le icone piene vogliono anche la classe `icon--solid`.
%>
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <defs>
        <% # --- navigazione --- %>
        <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.2 12 3l9 7.2V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></symbol>
        <symbol id="i-trend" viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></symbol>
        <symbol id="i-fire" viewBox="0 0 24 24"><path d="M12 3c.6 3.5 3 4.6 4.4 6.6A7 7 0 1 1 5.2 13c.7 1.2 1.7 1.9 2.8 2 0-3.3 1.5-5.9 4-12z"/></symbol>
        <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3.5l2.7 5.6 6 .9-4.4 4.3 1.1 6.1L12 17.5 6.6 20.4l1.1-6.1L3.3 10l6-.9z"/></symbol>
        <symbol id="i-list" viewBox="0 0 24 24"><path d="M4 7h11M4 12h11M4 17h7"/><path d="M17 13.5v6l5-3z"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m15.8 15.8 4.2 4.2"/></symbol>
        <%
          # Una nuvola sbarrata: i video che stanno sul dispositivo e non
          # hanno più bisogno della rete.
        %>
        <symbol id="i-offline" viewBox="0 0 24 24"><path d="M22.6 17a5 5 0 0 0-4.6-7h-1.3a8 8 0 0 0-7-6"/><path d="M5 5a8 8 0 0 0 4 15h9a5 5 0 0 0 1.7-.3"/><path d="M3 3 21 21"/></symbol>
        <symbol id="i-hash" viewBox="0 0 24 24"><path d="M9.5 3.5 7.5 20.5M16.5 3.5l-2 17M4 8.5h16M3 15.5h16"/></symbol>

        <% # --- testata --- %>
        <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 15V10a6 6 0 1 0-12 0v5l-1.6 2.6A.6.6 0 0 0 4.9 19h14.2a.6.6 0 0 0 .5-1.4z" fill="currentColor"/><path d="M9.5 19a2.5 2.5 0 0 0 5 0"/></symbol>
        <symbol id="i-bell-off" viewBox="0 0 24 24"><path d="M18 15V10a6 6 0 1 0-12 0v5l-1.6 2.6A.6.6 0 0 0 4.9 19h14.2a.6.6 0 0 0 .5-1.4z"/><path d="M9.5 19a2.5 2.5 0 0 0 5 0"/></symbol>
        <symbol id="i-cog" viewBox="0 0 24 24"><path d="M3.5 7.5h9M17.4 7.5h3.1M3.5 16.5h3.1M11.4 16.5h9.1"/><circle cx="15" cy="7.5" r="2.5"/><circle cx="9" cy="16.5" r="2.5"/></symbol>
        <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.5 12h2M19.5 12h2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"/></symbol>
        <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.5 8.5 0 1 0 20 14.2"/></symbol>
        <symbol id="i-exit" viewBox="0 0 24 24"><path d="M15 8.5V5.6a1.6 1.6 0 0 0-1.6-1.6H5.6A1.6 1.6 0 0 0 4 5.6v12.8A1.6 1.6 0 0 0 5.6 20h7.8a1.6 1.6 0 0 0 1.6-1.6v-2.9"/><path d="M20 12H9.5M17 8.8l3.2 3.2-3.2 3.2"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8.2" r="3.8"/><path d="M4.8 20a7.2 7.2 0 0 1 14.4 0"/></symbol>

        <% # --- azioni sui video --- %>
        <symbol id="i-play" viewBox="0 0 24 24"><path d="M7 4.8v14.4l12-7.2z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-play-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M10 8.4v7.2l5.4-3.6z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-headset" viewBox="0 0 24 24"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><path d="M4 14.5h2.2a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H5.5A1.5 1.5 0 0 1 4 18.5zM20 14.5h-2.2a1 1 0 0 0-1 1V19a1 1 0 0 0 1 1h.7a1.5 1.5 0 0 0 1.5-1.5z"/></symbol>
        <symbol id="i-jet" viewBox="0 0 24 24"><path d="M4.5 13.5 3 10l2-.6 2.4 2M20.6 3.4c.7.7-.4 3.3-2.6 5.5l-3.4 3.4-1.7 5.5-2.1 2.1-1.5-5-4-1.5 2.1-2.1 5.5-1.7 3.4-3.4c2.2-2.2 4.8-3.3 5.5-2.6zM10.5 19.5 14 21l.6-2-2-2.4"/></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/></symbol>
        <symbol id="i-eye-off" viewBox="0 0 24 24"><path d="M9.6 6.2A8.6 8.6 0 0 1 12 5.8c6 0 9.5 6.2 9.5 6.2a17 17 0 0 1-3 3.8M6 8a17 17 0 0 0-3.5 4S6 18.2 12 18.2c1 0 1.9-.2 2.7-.5"/><path d="M4 4l16 16"/></symbol>
        <symbol id="i-add" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke-width="2"/></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4.5 6.5h15M9.5 6.5V4.8a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v1.7"/><path d="M6.5 6.5 7.4 19a1.2 1.2 0 0 0 1.2 1.1h6.8a1.2 1.2 0 0 0 1.2-1.1l.9-12.5"/><path d="M10.5 10v6M13.5 10v6"/></symbol>
        <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4l10-10a2.4 2.4 0 0 0-3.4-3.4L4.6 16.6z"/><path d="M14.2 7.2 17 10"/></symbol>
        <symbol id="i-tick" viewBox="0 0 24 24"><path d="m5 12.8 4.6 4.7L19 6.5" stroke-width="2.2"/></symbol>
        <symbol id="i-save" viewBox="0 0 24 24"><path d="M12 3.5v13"/><path d="m7.5 12 4.5 4.5 4.5-4.5"/><path d="M4.5 20h15"/></symbol>
        <symbol id="i-share" viewBox="0 0 24 24"><path d="M9 13.5 15.5 10M9 10.5 15.5 14"/><circle cx="6.5" cy="12" r="2.8"/><circle cx="17.5" cy="7.5" r="2.8"/><circle cx="17.5" cy="16.5" r="2.8"/></symbol>
        <symbol id="i-thumbup" viewBox="0 0 24 24"><path d="M7 20V9.6l4.4-6a1.4 1.4 0 0 1 2.4 1.1L13 9.6h4.8a2.2 2.2 0 0 1 2.1 2.7l-1.4 6a2.2 2.2 0 0 1-2.1 1.7z"/><path d="M7 20H4.6V9.6H7"/></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20.3 4.2 12.6a4.9 4.9 0 0 1 7-6.9l.8.8.8-.8a4.9 4.9 0 0 1 7 6.9z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-comment" viewBox="0 0 24 24"><path d="M20.5 12.6c0 3.9-3.8 7-8.5 7a10 10 0 0 1-2.6-.3L4.2 21l1.3-3.7a6.6 6.6 0 0 1-2-4.7c0-3.9 3.8-7 8.5-7s8.5 3.1 8.5 7z"/></symbol>
        <symbol id="i-video" viewBox="0 0 24 24"><rect x="2.5" y="5.5" width="13" height="13" rx="2.5"/><path d="m15.5 13 5 3.2V7.8L15.5 11z"/></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" stroke-width="2"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm4.3 6.9-5 5.4a1 1 0 0 1-1.5 0l-2.2-2.3a1 1 0 0 1 1.4-1.4l1.5 1.6 4.3-4.7a1 1 0 0 1 1.5 1.4z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3.8 21 19.5H3z"/><path d="M12 9.8v4M12 16.4h.01" stroke-width="2"/></symbol>
        <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20.2 4.2v4.4h-4.4"/></symbol>

        <% # --- frecce --- %>
        <symbol id="i-chev-l" viewBox="0 0 24 24"><path d="M14.5 6 8.5 12l6 6" stroke-width="2"/></symbol>
        <symbol id="i-chev-r" viewBox="0 0 24 24"><path d="M9.5 6l6 6-6 6" stroke-width="2"/></symbol>
        <symbol id="i-chev-u" viewBox="0 0 24 24"><path d="M6 14.5 12 8.5l6 6" stroke-width="2"/></symbol>
        <symbol id="i-chev-d" viewBox="0 0 24 24"><path d="M6 9.5 12 15.5l6-6" stroke-width="2"/></symbol>

        <% # --- gestione account e dati --- %>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2.2"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"/></symbol>
        <symbol id="i-unlock" viewBox="0 0 24 24"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2.2"/><path d="M8 10.5V7.8a4 4 0 0 1 7.6-1.7"/></symbol>
        <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"/><path d="M12 12h9M18 12v3.2M15.5 12v2.4"/></symbol>
        <symbol id="i-data" viewBox="0 0 24 24"><ellipse cx="12" cy="6.2" rx="7.5" ry="2.9"/><path d="M4.5 6.2v11.6c0 1.6 3.4 2.9 7.5 2.9s7.5-1.3 7.5-2.9V6.2"/><path d="M19.5 12c0 1.6-3.4 2.9-7.5 2.9S4.5 13.6 4.5 12"/></symbol>
        <symbol id="i-box" viewBox="0 0 24 24"><path d="M3.5 7.6 12 3.4l8.5 4.2v8.8L12 20.6l-8.5-4.2z"/><path d="M3.5 7.6 12 11.9l8.5-4.3M12 11.9v8.7"/></symbol>
        <symbol id="i-doc" viewBox="0 0 24 24"><path d="M13.5 3.5H6.8a1.8 1.8 0 0 0-1.8 1.8v13.4a1.8 1.8 0 0 0 1.8 1.8h10.4a1.8 1.8 0 0 0 1.8-1.8V8.5z"/><path d="M13.5 3.5v5h5.5M8.5 13h7M8.5 16.5h5"/></symbol>
        <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3.2 9.5h17.6M3.2 14.5h17.6"/><ellipse cx="12" cy="12" rx="3.8" ry="9"/></symbol>
        <symbol id="i-wallet" viewBox="0 0 24 24"><path d="M3.5 8.2a2 2 0 0 1 2-2h11.6a2 2 0 0 1 2 2v.8"/><rect x="3.5" y="8.2" width="17" height="11.6" rx="2"/><circle cx="16" cy="14" r="1.4" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-title" viewBox="0 0 24 24"><path d="M4 6.5h16M4 12h11M4 17.5h7"/></symbol>

        <% # --- marchi esterni --- %>
        <symbol id="i-rss" viewBox="0 0 24 24"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="5.6" cy="18.4" r="1.8" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-youtube" viewBox="0 0 24 24"><rect x="2.5" y="5.8" width="19" height="12.4" rx="4"/><path d="M10.4 9.6v4.8l4.3-2.4z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-github" viewBox="0 0 24 24"><path d="M12 2.2a9.8 9.8 0 0 0-3.1 19.1c.5.1.7-.2.7-.5v-1.8c-2.7.6-3.3-1.3-3.3-1.3-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8a2 2 0 0 1 .6-1.3c-2.2-.2-4.5-1.1-4.5-4.9a3.8 3.8 0 0 1 1-2.6 3.5 3.5 0 0 1 .1-2.6s.8-.3 2.7 1a9.3 9.3 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1a3.5 3.5 0 0 1 .1 2.6 3.8 3.8 0 0 1 1 2.6c0 3.8-2.3 4.7-4.5 4.9a2.3 2.3 0 0 1 .7 1.8v2.6c0 .3.2.6.7.5A9.8 9.8 0 0 0 12 2.2z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-js" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M10 9.5v5.2a1.8 1.8 0 0 1-3.4.8M17.8 10.4a2 2 0 0 0-3.6 1.1c0 2 3.4 1.5 3.4 3.4a2 2 0 0 1-3.7.9"/></symbol>
    </defs>
</svg>
