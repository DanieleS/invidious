<% if channel.banner %>
    <img class="channel-banner" style="width:100%;border-radius:var(--r-panel)" src="/ggpht<%= URI.parse(channel.banner.not_nil!.gsub("=w1060-", "=w1280-")).request_target %>" alt="" />
<% end %>

<div class="channel-head">
    <img class="avatar avatar--64" src="/ggpht<%= channel_profile_pic %>" alt="" />

    <div class="channel-head__text">
        <h1 class="channel-head__name">
            <%= author %><% if !channel.verified.nil? && channel.verified %> <svg class="verified"><use href="#i-check"/></svg><% end %>
        </h1>
        <% if !channel.pronouns.nil? %>
            <span class="channel-pronouns"><%= channel.pronouns %></span>
        <% end %>
        <span class="channel-head__sub"><%= I18n.translate_count(locale, "generic_subscribers_count", channel.sub_count, I18n::NumberFormatting::Short) %></span>
    </div>

    <% sub_count_text = number_to_short_text(channel.sub_count) %>
    <%= rendered "components/subscribe_widget" %>

    <a class="btn" dir="auto" href="/feed/channel/<%= ucid %>">
        <svg class="icon icon--sm"><use href="#i-rss"/></svg>
        <%= I18n.translate(locale, "generic_button_rss") %>
    </a>
</div>

<div id="descriptionWrapper" class="channel-desc"><%= channel.description_html %></div>

<div class="pillbar">
    <%= Invidious::Frontend::ChannelPage.generate_tabs_links(locale, channel, selected_tab) %>
</div>

<div class="page-head">
    <div class="pillbar pillbar--quiet">
        <% sort_options.each do |sort| %>
            <a class="pill" href="<%= relative_url %>?sort_by=<%= sort %>"<% if sort_by == sort %> aria-current="page"<% end %>>
                <%= I18n.translate(locale, sort) %>
            </a>
        <% end %>
    </div>

    <div class="player-links" style="margin-inline-start:auto">
        <a href="<%= youtube_url %>"><%= I18n.translate(locale, "View channel on YouTube") %></a>
        <a href="<%= redirect_url %>"><%= I18n.translate(locale, "Switch Invidious Instance") %></a>
    </div>
</div>
