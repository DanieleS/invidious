{
    "id": "/",
    "name": "Invidious",
    "short_name": "Invidious",
    "description": "An alternative front-end to YouTube",
    "lang": "en",
    "dir": "auto",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "browser"],
    "orientation": "any",
    "theme_color": "#0a0d13",
    "background_color": "#575757",
    "categories": ["entertainment", "video", "music"],
    "icons": [
        {
            "src": "/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/android-chrome-maskable-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Offline",
            "url": "/offline",
            "description": "Videos saved on this device"
        },
        {
            "name": "Subscriptions",
            "url": "/feed/subscriptions"
        },
        {
            "name": "Trending",
            "url": "/feed/trending"
        },
        {
            "name": "Search",
            "url": "/search"
        }
    ]
}
